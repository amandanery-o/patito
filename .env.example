# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
VITE_APP_VERSION=dev

# Secrets do servidor são configurados no Supabase, nunca neste arquivo Vite:
# GITHUB_ISSUES_TOKEN
# GITHUB_ISSUES_REPOSITORY=amandanery-o/patito

# Pipeline editorial local — nunca usar prefixo VITE_ nem enviar ao navegador:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=identificador-do-modelo-liberado-na-sua-conta
